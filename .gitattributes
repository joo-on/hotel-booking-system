# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Gradle wrapper
gradle/wrapper/gradle-wrapper.jar binary